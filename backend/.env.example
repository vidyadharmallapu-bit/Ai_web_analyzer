# CyberShield AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── PhonePe Payment Gateway ────────────────────────────────────────────────
# Get your credentials from PhonePe Business / Merchant Portal
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=uat

# ─── Payment Mode ─────────────────────────────────────────────────────────────
# "test"  → uses test credentials, shows TEST MODE banner in UI
# "live"  → uses live credentials, never mix with test order IDs
PAYMENT_MODE=test

# ─── OAuth / Social Login ───────────────────────────────────────────────────
# Google Cloud Console: APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_secret

MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_secret
MICROSOFT_TENANT_ID=common

X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_secret

SESSION_SECRET=your_random_secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Microsoft Entra ID / Azure Portal: App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# X Developer Portal: Projects & Apps → OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./cybershield.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/cybershield
